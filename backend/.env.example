# Environment configuration
APP_ENV=development
PORT=8000

# SQLite database file location
# For local development: sqlite:///./crm.db
# For Railway persistent volume (e.g. mounted at /data): sqlite:////data/crm.db
DATABASE_URL=sqlite:///./crm.db

# CORS Allowed Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Optional AI feature configuration (leave empty or provide Gemini/OpenAI API key)
AI_PROVIDER=mock
AI_API_KEY=
